# Sem nenhuma variável o app roda 100% local (modo demo): PGlite em .data/, login local,
# IA offline, e-mail só no log. Copie para apps/web/.env.local e preencha o que tiver.

APP_ENV=local                 # local | staging | production
APP_URL=http://localhost:3000

# Supabase (região São Paulo). STAGING primeiro — nunca chaves de produção aqui.
DATABASE_URL=                 # string do pooler (modo transação, porta 6543)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Segredos (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
AUTH_SECRET=
APP_ENCRYPTION_KEY=           # criptografa telefone e e-mail das clientes
CRON_SECRET=

# Contas de demonstração (Carla, João, sócio) — só fora de produção
DEMO_PASSWORD=ground-demo-2026

# IA (Anthropic). Sem chave: modo offline determinístico.
ANTHROPIC_API_KEY=
RESEARCH_ENABLED=0            # pesquisa de concorrência na web: só depois do aval dos sócios sobre as fontes

# E-mail (Resend). Sem chave: os e-mails só aparecem no log.
RESEND_API_KEY=
EMAIL_FROM=Ground <nao-responda@example.com>
GROUND_NOTIFY_EMAIL=          # para onde vão os avisos de gargalo e "Converse com a Ground"
